{
  "name": "utahsnowpack",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "fetch:dry": "pnpm --filter @utahsnowpack/pipeline fetch:dry",
    "fetch:all": "pnpm --filter @utahsnowpack/pipeline fetch:all",
    "build:registry": "pnpm --filter @utahsnowpack/pipeline build:registry",
    "build:snowpack": "pnpm --filter @utahsnowpack/pipeline build:snowpack",
    "dev": "pnpm -r --parallel dev",
    "preview": "pnpm --filter @utahsnowpack/app preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
